# Copy to terraform.tfvars to override defaults. The Gemini key is passed separately:
#   export TF_VAR_gemini_api_key=...   (scripts/deploy.sh reads it from ../ledgerAI_h5/api/.env if unset)
region            = "us-east-1"
availability_zone = "us-east-1a"
instance_type     = "t4g.small"
data_volume_gb    = 20
default_currency  = "GBP"
admin_emails      = ["you@example.com"]
root_domain       = "yourdomain.com"   # registered in Route 53; app is served at www.<root_domain>
