NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledgerai
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# Gemini (https://aistudio.google.com/apikey). Set MOCK_AI=true to develop without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MOCK_AI=false

# Receipt images: local (dev) | s3 (EC2 + instance role with s3:PutObject/GetObject/DeleteObject)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=
AWS_REGION=eu-west-2

DEFAULT_CURRENCY=GBP
TRUST_PROXY_HOPS=1
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=
